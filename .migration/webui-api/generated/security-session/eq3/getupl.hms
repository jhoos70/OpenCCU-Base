!##
!# Returns the privilege level (user privilege level, UPL) of a session (v1 frozen, staged SP003)
!# The session id is injected as the variable _session_id_ by hmscript_runFromFile.
!##

var upl = 0;

if ( system.IsVar("_session_id_") )
{
	var id = system.GetVar("_session_id_");
	var s  = system.GetSessionVarStr(id);
	if (s) { upl = s.StrValueByIndex(";", 1); }
}

Write(upl);