package require tcltest
namespace import ::tcltest::*

# SP025 NFR and integration coverage (spec.json#SP025 non_functional_requirements[0..11]; NFR10 is
# the v2 model route of SP044), boundary and error cases and the golden re-run of the Device.* read
# fixtures through the staged scripts.
set here [file dirname [file normalize [info script]]]
set gen [file dirname [file dirname [file dirname $here]]]
source [file join $gen schema-harness tests helpers mocks.tcl]
source [file join $gen schema-harness tests helpers golden.tcl]

proc call {method params args} { return [golden::call $method $params -candidate only:rega-model {*}$args] }
proc err {r} {
  if {[regexp {"code": (\d+),\s*"message": "((?:[^"\\]|\\.)*)"} [dict get $r body] -> c m]} { return [list $c $m] }
  return none
}
proc result {r} {
  if {[regexp {"result": (.*),"error": null\}$} [string trim [dict get $r body]] -> j]} { return $j }
  return "ERR:[err $r]"
}
set S {_session_id_ AbCdEf1234}
proc chn {id} {
  return "ID $id NAME ch$id ADDRESS NEQ1:$id DEVICE 1 INDEX $id GROUP_PARTNER_ID 65535 READY_CONFIG true MODE MODE_DEFAULT CATEGORY CATEGORY_NONE USABLE true LOGGED false VISIBLE true LOGABLE true READABLE true WRITABLE false EVENTABLE true AES_AVAILABLE false VIRTUAL false CHANNEL_TYPE KEY CHANNEL_NAME HM-X"
}
proc dev {id} {
  return [list ID $id NAME "Dev $id" ADDRESS NEQ$id INTERFACE BidCos-RF DEVICE_TYPE HM-X READY_CONFIG true GROUP_ONLY false CHANNELS [list [chn 1]]]
}

test sp025-nfr0 {NFR0: listAllDetail makes 1 + N script round-trips (one per device) after the privilege lookup (frozen N+1 cost)} -body {
  set rules [list [list {*Write("ID *} [dev 1]] [list {*EnumIDs()*} {{1} {2} {3}}]]
  set r [call Device.listAllDetail $S -rega $rules]
  set n 0
  foreach c [dict get $r rega_calls] { if {![string match *StrValueByIndex* $c]} { incr n } }
  set n
} -result 4

test sp025-nfr7 {NFR7: a failing ReGa script gives [] for listAll and listAllDetail and "" for getNewDeviceCount (no error)} -body {
  set f {*}
  list [result [call Device.listAll $S -regafail {*EnumIDs()*}]] [result [call Device.listAllDetail $S -regafail {*EnumIDs()*}]] [result [call Device.getNewDeviceCount $S -regafail {*iNewCount*}]]
} -result {{[]} {[]} {""}}

test sp025-nfr8 {NFR8: internal channels are excluded in the scripts of get and listAllDetail} -body {
  set a [call Device.listAllDetail $S -rega [list [list {*Write("ID *} [dev 1]] [list {*EnumIDs()*} {{1}}]]]
  set b [call Device.get [list {*}$S id 1] -rega [list [list {*Write("ID *} [dev 1]]]]
  list [string match {*false == channel.Internal()*} [join [dict get $a rega_calls] \n]] [string match {*false == channel.Internal()*} [join [dict get $b rega_calls] \n]]
} -result {1 1}

test sp025-nfr9 {NFR9: listAllDetail emits the device isReady as a string and the channel isReady as the raw token} -body {
  set a [call Device.listAllDetail $S -rega [list [list {*Write("ID *} [dev 1]] [list {*EnumIDs()*} {{1}}]]]
  set j [result $a]
  list [regexp {"isReady":"true","channels"} $j] [regexp {"isReady":true,"isUsable"} $j]
} -result {1 1}

test sp025-nfr6 {NFR6: getRFAddressOfAllDevices calls hmscript without an argument array - the script gets no variable declarations} -body {
  set r [call Device.getRFAddressOfAllDevices $S -rega {{*EnumUsedIDs()* x}}]
  set script [lindex [dict get $r rega_calls] end]
  string match {*var *} [lindex [split $script \n] 0]
} -result 0

test sp025-err1 {an address with quotes and backslashes is escaped before it reaches the ReGa script (no script injection)} -body {
  set r [call Device.getReGaIDByAddress {_session_id_ AbCdEf1234 address {x"; Write("pwned");}}]
  set script [lindex [dict get $r rega_calls] end]
  list [string match {*var address = "x\\"; Write(\\"pwned\\");";*} $script] [string match {*var address = "x"; Write*} $script]
} -result {1 0}

test sp025-err2 {a control character in the address is error 403 before any ReGa script of the method} -body {
  set body "\{\"method\":\"Device.getReGaIDByAddress\",\"params\":\{\"_session_id_\":\"AbCdEf1234\",\"address\":\"a\\u0001b\"\},\"id\":1\}"
  set r [golden::call_raw $body [golden::prepare [list -candidate only:dispatcher,security-session,rega-model -sessions {{AbCdEf1234 8 1000 Admin}}]]]
  err $r
} -result {403 {invalid argument (address)}}

test sp025-golden {golden re-run: the Device.* read fixtures replay byte-identical through the staged scripts} -body {
  golden::compare_all -candidate only:rega-model -only {Device.listAll Device.listAllDetail Device.get Device.getNewDeviceCount Device.getReGaIDByAddress Device.getRFAddressByAddress Device.getRFAddressOfAllDevices}
} -result {}

cleanupTests
