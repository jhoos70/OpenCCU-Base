package require tcltest
namespace import ::tcltest::*

# SP045 - system info helpers (system.getEnergyPrice NONE, getPositionData / getTweak /
# saveObjectModel USER): v1 output forms frozen, strict JSON on /api/v2, getTweak key validated.
# contracts/behavioral-contracts.json#SP045
set here [file dirname [file normalize [info script]]]
set gen [file dirname [file dirname $here]]
source [file join $gen schema-harness tests helpers mocks.tcl]
source [file join $gen schema-harness tests helpers golden.tcl]

set CAND only:dispatcher,security-session,user-profile
proc call {method params args} { return [golden::call $method $params -candidate $::CAND {*}$args] }
proc err {r} {
  if {[regexp {"code": (\d+),\s*"message": "((?:[^"\\]|\\.)*)"} [dict get $r body] -> c m]} { return [list $c $m] }
  return none
}
proc result {r} {
  if {[regexp {"result": (.*),"error": null\}$} [string trim [dict get $r body]] -> j]} { return $j }
  return "ERR:[err $r]"
}
set USER {{AbCdEf1234 2 1000 User}}
set S {_session_id_ AbCdEf1234}
set V2 {-setenv {REQUEST_URI /api/v2/rpc} -header {X-Requested-With XMLHttpRequest} -header {X-Session-Id AbCdEf1234}}

test sp045-0 {the staged method scripts of SP045 exist and are complete Tcl} -body {
  set bad {}
  foreach f {getenergyprice getpositiondata gettweak saveobjectmodel} {
    set p [file join $gen user-profile methods system $f.tcl]
    if {![file exists $p]} { lappend bad $f; continue }
    set fd [open $p r]; set c [read $fd]; close $fd
    if {![info complete $c]} { lappend bad $f }
  }
  set bad
} -result {}

test sp045-1 {acceptance[0],[1]: getEnergyPrice with two lines answers {"Price":..,"Currency":..}; a missing file answers unknown/unknown (no session needed)} -body {
  list [result [call system.getEnergyPrice {} -sessions {} -files [list etc/config/energyPrice "0.28\nEUR\n"]]] [result [call system.getEnergyPrice {} -sessions {}]]
} -result {{{"Price" : "0.28","Currency" : "EUR"}} {{"Price" : "unknown","Currency" : "unknown"}}}

test sp045-2 {acceptance[2] (frozen v1): any other number of lines are ready-made JSON members, concatenated raw; an empty file gives the invalid '{,,,,}' (NFR0)} -body {
  set five "\"Currency\":\"EUR\"\n\"PriceCurrent\":0.3\n\"PriceGas\":0.1\n\"GasHeatingValue\":10\n\"GasConditionNumber\":1\n"
  list [result [call system.getEnergyPrice {} -sessions {} -files [list etc/config/energyPrice $five]]] [result [call system.getEnergyPrice {} -sessions {} -files [list etc/config/energyPrice ""]]]
} -result [list {{"Currency":"EUR","PriceCurrent":0.3,"PriceGas":0.1,"GasHeatingValue":10,"GasConditionNumber":1}} {{,,,,}}]

test sp045-3 {acceptance[7] [V2]: getEnergyPrice is strict JSON on /api/v2/rpc, an invalid file content gives unknown/unknown} -body {
  set five "\"Currency\":\"EUR\"\n\"PriceCurrent\":0.3\n\"PriceGas\":0.1\n\"GasHeatingValue\":10\n\"GasConditionNumber\":1\n"
  list [result [call system.getEnergyPrice {} -sessions {} -files [list etc/config/energyPrice "0.30\nEUR\n"] {*}$::V2]] \
    [result [call system.getEnergyPrice {} -sessions {} -files [list etc/config/energyPrice $five] {*}$::V2]] \
    [result [call system.getEnergyPrice {} -sessions {} -files [list etc/config/energyPrice ""] {*}$::V2]]
} -result [list {{"Price":"0.30","Currency":"EUR"}} {{"Currency":"EUR","PriceCurrent":0.3,"PriceGas":0.1,"GasHeatingValue":10,"GasConditionNumber":1}} {{"Price":"unknown","Currency":"unknown"}}]

test sp045-4 {acceptance[3],NFR2,NFR4: getPositionData answers the single-quoted JS array with the time zone of time.conf (default CET/CEST)} -body {
  set rega {{*system.Longitude()* {['Longitude:8.4','Latitude:49.0'}}}
  list [result [call system.getPositionData $S -sessions $USER -rega $rega -files [list etc/config/time.conf "TIMEZONE=Europe/Berlin\n"]]] [result [call system.getPositionData $S -sessions $USER -rega $rega]]
} -result [list {['Longitude:8.4','Latitude:49.0','TimeZone:Europe/Berlin']} {['Longitude:8.4','Latitude:49.0','TimeZone:CET/CEST']}]

test sp045-5 {NFR3 (frozen v1): a failing ReGa script makes the answer begin with a comma} -body {
  result [call system.getPositionData $S -sessions $USER]
} -result {,'TimeZone:CET/CEST']}

test sp045-6 {acceptance[7] [V2]: getPositionData is a strict JSON array with double quotes} -body {
  result [call system.getPositionData {} -sessions $USER -rega {{*system.Longitude()* {['Longitude:8.4','Latitude:49.0'}}} {*}$::V2]
} -result {["Longitude:8.4","Latitude:49.0","TimeZone:CET\/CEST"]}

test sp045-7 {acceptance[4]: getTweak answers the first matching line value verbatim (unquoted), false when empty or missing} -body {
  set tw "# comment\nfoo = 17\n  bar=baz\nfoo=18\n"
  list [result [call system.getTweak [list {*}$S key foo] -sessions $USER -files [list etc/config/tweaks $tw]]] \
    [result [call system.getTweak [list {*}$S key bar] -sessions $USER -files [list etc/config/tweaks $tw]]] \
    [result [call system.getTweak [list {*}$S key nope] -sessions $USER -files [list etc/config/tweaks $tw]]] \
    [result [call system.getTweak [list {*}$S key foo] -sessions $USER]]
} -result {17 baz false false}

test sp045-8 {acceptance[6] [TARGET]: a key outside ^[A-Za-z0-9_.-]{1,64}$ is error 403 'invalid argument (key)'; '.' in the key matches only a dot} -body {
  set tw "a.b = dot\naXb = other\n"
  list [err [call system.getTweak [list {*}$S key {a(b}] -sessions $USER -files [list etc/config/tweaks $tw]]] \
    [err [call system.getTweak [list {*}$S key [string repeat k 65]] -sessions $USER]] \
    [err [call system.getTweak [list {*}$S key {}] -sessions $USER]] \
    [result [call system.getTweak [list {*}$S key a.b] -sessions $USER -files [list etc/config/tweaks $tw]]] \
    [result [call system.getTweak [list {*}$S key aXb] -sessions $USER -files [list etc/config/tweaks $tw]]]
} -result {{403 {invalid argument (key)}} {403 {invalid argument (key)}} {403 {invalid argument (key)}} dot other}

test sp045-9 {NFR1 (frozen v1): a plain word value is placed unquoted; acceptance[7] [V2]: getTweak is a JSON string or JSON false} -body {
  set tw "mode = fast\nnum = 5\n"
  list [result [call system.getTweak [list {*}$S key mode] -sessions $USER -files [list etc/config/tweaks $tw]]] \
    [result [call system.getTweak {key mode} -sessions $USER -files [list etc/config/tweaks $tw] {*}$::V2]] \
    [result [call system.getTweak {key num} -sessions $USER -files [list etc/config/tweaks $tw] {*}$::V2]] \
    [result [call system.getTweak {key none} -sessions $USER -files [list etc/config/tweaks $tw] {*}$::V2]]
} -result {fast {"fast"} {"5"} false}

test sp045-10 {acceptance[5]: saveObjectModel starts the asynchronous system.Save() through system.Exec and answers true} -body {
  set r [call system.saveObjectModel $S -sessions $USER -rega {{*system.Exec* true}}]
  list [result $r] [string match {*system.Exec("echo 'load tclrega.so; rega system.Save()' | /bin/tclsh &");*} [lindex [dict get $r rega_calls] end]]
} -result {true 1}

test sp045-11 {privilege: getEnergyPrice needs no session, getPositionData / getTweak / saveObjectModel need USER (GUEST -> 400)} -body {
  set out {}
  foreach m {system.getPositionData system.getTweak system.saveObjectModel} {
    lappend out [lindex [err [call $m {_session_id_ AbCdEf1234 key foo} -sessions {{AbCdEf1234 1 1000 Guest}}]] 0]
  }
  set out
} -result {400 400 400}

cleanupTests
