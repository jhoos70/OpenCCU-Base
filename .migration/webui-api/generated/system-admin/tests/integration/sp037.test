package require tcltest
namespace import ::tcltest::*

# SP037 NFR and integration coverage (spec.json#SP037 non_functional_requirements[0..3]),
# boundary and error cases. No golden re-run: the v1 answer for an unknown version was two
# JSON documents (a defect fixed deliberately), which cannot be a frozen contract.
set here [file dirname [file normalize [info script]]]
set gen [file dirname [file dirname [file dirname $here]]]
source [file join $gen schema-harness tests helpers mocks.tcl]
source [file join $gen schema-harness tests helpers golden.tcl]

proc call {method params args} { return [golden::call $method $params -candidate only:system-admin {*}$args] }
proc result {r} {
  if {[regexp {"result": (.*),"error": null\}$} [string trim [dict get $r body]] -> j]} { return $j }
  return "ERR"
}
set S {_session_id_ AbCdEf1234}
set WGET_OK {{*wget*} {} {set fd [open [lindex $cmd end-1] w]; puts -nonewline $fd FIRMWARE; close $fd}}

test sp037-nfr0 {NFR0: a /VERSION without a VERSION= line gives false and no wget (v1 carried the error text as version)} -body {
  set r [call CCU.downloadFirmware $S -files [list VERSION "BUILD=1\n"] -exec [list $WGET_OK]]
  list [result $r] [dict get $r exec_calls]
} -result {false {}}

test sp037-nfr1 {NFR1: lang=de and the product name are hard-coded in the URL} -body {
  set r [call CCU.downloadFirmware $S -files [list VERSION "VERSION=3.1\n" var/board_serial "S1\n"] -exec [list $WGET_OK]]
  set url [lindex [lindex [dict get $r exec_calls] 0] end]
  list [string match {*&lang=de&product=HM-CCU3} $url] [result $r]
} -result {1 true}

test sp037-nfr2 {NFR2: a previous /tmp/fup.tgz is overwritten, no size/checksum check is made} -body {
  set fs [mock::fs::create]
  mock::fs::write $fs tmp/fup.tgz OLDOLDOLDOLDOLD
  call CCU.downloadFirmware $S -fs $fs -files [list VERSION "VERSION=3.1\n" var/board_serial "S1\n"] -exec [list $WGET_OK]
  set c [mock::fs::read $fs tmp/fup.tgz]
  mock::fs::destroy $fs
  set c
} -result FIRMWARE

test sp037-nfr3 {NFR3: the response never contains the wget stderr, the URL or the serial} -body {
  set r [call CCU.downloadFirmware $S -files [list VERSION "VERSION=3.1\n" var/board_serial "SERIALXYZ\n"] -execfail {{{*wget*} {wget: https://ccu3-update.homematic.com/...serial=SERIALXYZ: 404}}}]
  list [result $r] [string match *SERIALXYZ* [dict get $r stdout]] [string match *wget* [dict get $r stdout]]
} -result {false 0 0}

test sp037-err1 {exactly one response document per request on every path} -body {
  set out {}
  foreach {files execfail} [list [list VERSION "VERSION=7.0\n"] {} [list VERSION "VERSION=3.1\n" var/board_serial "S\n"] {{{*wget*} bad}} [list VERSION "VERSION=3.1\n"] {}] {
    set r [call CCU.downloadFirmware $S -files $files -execfail $execfail]
    lappend out [regexp -all {"version": "1.1"} [dict get $r stdout]]
  }
  set out
} -result {1 1 1}

cleanupTests
