package require tcltest
namespace import ::tcltest::*

# The alarm and service message sections of GET /api/v2/model: the data behind the alarm and service
# indicators of the classic header (UpdateUI of rega/www/esp/system.fn). The ReGa scripts themselves can only be
# proven on a real ReGa (nested ifs: a long && chain is not short-circuited there); see the test notes in
# src/webui/next/README.md. Here: the JSON built from the script output, paging, sections, the script source.
set here [file dirname [file normalize [info script]]]
set gen [file dirname [file dirname $here]]
source [file join $gen schema-harness tests helpers mocks.tcl]
# the component code lives in ::mock::generated (the tests tree is not the code tree in the repository)
set gen $::mock::generated
source [file join $gen schema-harness tests helpers golden.tcl]

set CAND only:dispatcher,security-session,rega-model
proc err {r} {
  if {[regexp {"code": (\d+),\s*"message": "((?:[^"\\]|\\.)*)"} [dict get $r body] -> c m]} { return [list $c $m] }
  return none
}
proc status {r} {
  if {[regexp {Status: (\d+)} [dict get $r headers] -> s]} { return $s }
  return 200
}
set GUEST {{AbCdEf1234 1 1000 Guest}}
proc model {query args} {
  return [golden::call_raw {} [golden::prepare [list -candidate $::CAND -method GET -contenttype {} -setenv {REQUEST_URI /api/v2/model} -query $query \
    -header {X-Requested-With XMLHttpRequest} -header {X-Session-Id AbCdEf1234} -sessions $::GUEST {*}$args]]]
}

set ALARMS {*ID_SYSTEM_VARIABLES*OT_ALARMDP*}
set SERVICES {*ID_SERVICES*}
proc alarm {id name time {ack true}} { return [list ID $id NAME $name TIME $time ACK $ack] }
proc svc {id args} {
  set d [dict create ID $id TIME {2026-10-31 19:35:05} CHANNEL {Kitchen:0} MESSAGE {Low battery} STICKY false ACK true]
  foreach {k v} $args { dict set d $k $v }
  set s ""
  dict for {k v} $d { append s [list $k $v] " " }
  return [string trimright $s]
}
proc body {r} { return [string trim [dict get $r body]] }

test messages-0 {the alarm section lists the triggered alarms as {id,name,occurredAt}} -body {
  set r [model "sections=alarms" -rega [list [list $::ALARMS [list [alarm 1034 {WatchDog: udevd-restart} {2026-10-31 19:35:05}] [alarm 1035 {Alarm 2} {2026-10-31 20:00:00}]]]]]
  list [status $r] [body $r]
} -result [list 200 {{"alarms":{"total":2,"offset":0,"limit":100,"items":[{"id":"1034","name":"WatchDog: udevd-restart","occurredAt":"2026-10-31 19:35:05","canAcknowledge":true},{"id":"1035","name":"Alarm 2","occurredAt":"2026-10-31 20:00:00","canAcknowledge":true}]}}}]

test messages-1 {no alarm and no service message: both sections are empty, not missing} -body {
  set r [model "sections=alarms,services" -rega [list [list $::ALARMS {}] [list $::SERVICES {}]]]
  body $r
} -result {{"alarms":{"total":0,"offset":0,"limit":100,"items":[]},"services":{"total":0,"offset":0,"limit":100,"items":[]}}}

test messages-2 {the service section lists the open service messages with channel, message and the sticky flag} -body {
  set r [model "sections=services" -rega [list [list $::SERVICES [list [svc 7] [svc 8 CHANNEL {Bad "Room":1} MESSAGE {${unknownMessage} (HM-X|UNREACH=TRUE)} STICKY true]]]]]
  body $r
} -result {{"services":{"total":2,"offset":0,"limit":100,"items":[{"id":"7","occurredAt":"2026-10-31 19:35:05","channelName":"Kitchen:0","message":"Low battery","isSticky":false,"canAcknowledge":true},{"id":"8","occurredAt":"2026-10-31 19:35:05","channelName":"Bad \"Room\":1","message":"${unknownMessage} (HM-X|UNREACH=TRUE)","isSticky":true,"canAcknowledge":true}]}}}

test messages-3 {a service record without optional attributes gets empty texts and isSticky false} -body {
  set r [model "sections=services" -rega [list [list $::SERVICES [list {ID 9}]]]]
  body $r
} -result {{"services":{"total":1,"offset":0,"limit":100,"items":[{"id":"9","occurredAt":"","channelName":"","message":"","isSticky":false,"canAcknowledge":false}]}}}

test messages-4 {limit and offset page both sections} -body {
  set recs {}
  foreach i {1 2 3} { lappend recs [alarm $i A$i {2026-10-31 19:00:00}] }
  set r [model "sections=alarms&limit=2&offset=1" -rega [list [list $::ALARMS $recs]]]
  set j [body $r]
  list [regexp {"total":3,"offset":1,"limit":2} $j] [regexp {"id":"2".*"id":"3"} $j] [regexp {"id":"1"} $j]
} -result {1 1 0}

test messages-5 {alarms and services are opt-in: the default sections do not run their scripts} -body {
  set r [model "" -sessions {{AbCdEf1234 2 1001 User}} -rega [list [list $::ALARMS [list [alarm 1 A {2026}]]] [list $::SERVICES [list [svc 1]]]]]
  set j [body $r]
  list [status $r] [regexp {"alarms"|"services"} $j]
} -result {200 0}

test messages-6 {a guest may read them (the model needs GUEST); without a session no ReGa script runs} -body {
  set a [golden::call_raw {} [golden::prepare [list -candidate $::CAND -method GET -contenttype {} -setenv {REQUEST_URI /api/v2/model} -query sections=alarms,services -header {X-Requested-With XMLHttpRequest}]]]
  list [status $a] [llength [dict get $a rega_calls]]
} -result {401 0}

test messages-7 {the ReGa scripts nest their ifs: a chain of && with IsTypeOf and AlState is not short-circuited by ReGa (the block then runs for every variable)} -body {
  set p [file join $gen rega-model v2 model.tcl]
  set fd [open $p r]; set c [read $fd]; close $fd
  list [regexp {IsTypeOf\(OT_ALARMDP\)\s*&&} $c] [regexp {AlState\(\)\s*==\s*asOncoming\)\s*&&\s*\(\w+\.State} $c]
} -result {0 1}

test messages-8 {an alarm whose trigger datapoint cannot be written is listed with canAcknowledge false (the classic rule), one without or with a writable trigger with true} -body {
  set r [model "sections=alarms" -rega [list [list $::ALARMS [list [alarm 1 A {2026-10-31 19:00:00} false] [alarm 2 B {2026-10-31 19:00:00} true]]]]]
  set j [body $r]
  list [regexp {"id":"1","name":"A","occurredAt":"[^"]*","canAcknowledge":false} $j] [regexp {"id":"2","name":"B","occurredAt":"[^"]*","canAcknowledge":true} $j]
} -result {1 1}

cleanupTests
