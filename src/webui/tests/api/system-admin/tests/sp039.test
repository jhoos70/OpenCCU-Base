package require tcltest
namespace import ::tcltest::*

# SP039 - CCU identity and device-state reads/flags: contracts/behavioral-contracts.json#SP039
set here [file dirname [file normalize [info script]]]
set gen [file dirname [file dirname $here]]
source [file join $gen schema-harness tests helpers mocks.tcl]
# the component code lives in ::mock::generated (the tests tree is not the code tree in the repository)
set gen $::mock::generated
source [file join $gen schema-harness tests helpers golden.tcl]
testConstraint unixNotRoot [expr {[info exists ::tcl_platform(user)] && $::tcl_platform(user) ne "root"}]

proc call {method params args} { return [golden::call $method $params -candidate only:system-admin {*}$args] }
proc err {r} {
  if {[regexp {"code": (\d+),\s*"message": "((?:[^"\\]|\\.)*)"} [dict get $r body] -> c m]} { return [list $c $m] }
  return none
}
proc result {r} {
  if {[regexp {"result": (.*),"error": null\}$} [string trim [dict get $r body]] -> j]} { return $j }
  return "ERR:[err $r]"
}
set S {_session_id_ AbCdEf1234}
set USER {{AbCdEf1234 2 1000 User}}
set IDS "SerialNumber=OEQ1234567\nBidCoS-Address=0123456789\n"

test sp039-0 {the staged method scripts of SP039 exist and are complete Tcl} -body {
  set bad {}
  foreach f {getserial getaddress getheatinggrouplist gethmipaddress getinfoledconfig getstickyunreachstate getversion removeFieldTestActive setinfoledconfig setstickyunreach} {
    set p [file join $gen system-admin methods ccu $f.tcl]
    if {![file exists $p]} { lappend bad $f; continue }
    set fd [open $p r]; set c [read $fd]; close $fd
    if {![info complete $c]} { lappend bad $f }
  }
  set bad
} -result {}

test sp039-1 {getSerial/getAddress/getHmIPAddress/getVersion return the value of their key as a JSON string} -body {
  list [result [call CCU.getSerial $S -files [list var/ids $IDS]]] \
       [result [call CCU.getAddress $S -files [list var/ids $IDS]]] \
       [result [call CCU.getHmIPAddress $S -files [list etc/config/hmip_address.conf "Adapter.1.Address = 3014F711A0\n"]]] \
       [result [call CCU.getVersion $S -files [list VERSION "VERSION=3.75.6\nBUILD=1\n"]]]
} -result {{"OEQ1234567"} {"0123456789"} {"3014F711A0"} {"3.75.6"}}

test sp039-2 {a missing key gives "" - the first matching line wins} -body {
  list [result [call CCU.getSerial $S -files [list var/ids "Other=1\n"]]] [result [call CCU.getSerial $S -files [list var/ids "SerialNumber=A\nSerialNumber=B\n"]]]
} -result {{""} {"A"}}

test sp039-3 {a missing source file is the v1 internal error 200 for the four getters} -body {
  set out {}
  foreach m {CCU.getSerial CCU.getAddress CCU.getHmIPAddress CCU.getVersion} { lappend out [lindex [err [call $m $S]] 0] }
  set out
} -result {200 200 200 200}

test sp039-4 {getHeatingGroupList: the whole /etc/config/groups.gson as one JSON string, "-1" if it cannot be opened} -body {
  set a [result [call CCU.getHeatingGroupList $S -files [list etc/config/groups.gson "\[\{\"id\":1\}\]"]]]
  set b [result [call CCU.getHeatingGroupList $S]]
  list $a $b
} -result [list {"[{\"id\":1}]"} {"-1"}]

test sp039-5 {getInfoLedConfig: the flags default to on; 'true' ignore flags switch a LED off; bare JSON booleans} -body {
  set a [result [call CCU.getInfoLedConfig $S -files [list etc/config/hss_led_info.conf "IgnoreServiceMessages=true\nIgnoreAlarmMessages=false\n"]]]
  set b [result [call CCU.getInfoLedConfig $S -files [list etc/config/hss_led_info.conf "IgnoreAlarmMessages=true\n"]]]
  list $a $b
} -result {{{"serviceLedOn":false,"alarmLedOn":true}} {{"serviceLedOn":true,"alarmLedOn":false}}}

test sp039-5b {getInfoLedConfig without the file: the v1 read_var raises inside catch, both LEDs on} -body {
  result [call CCU.getInfoLedConfig $S]
} -result {{"serviceLedOn":true,"alarmLedOn":true}}

test sp039-6 {setInfoLedConfig: IgnoreServiceMessages/IgnoreAlarmMessages are 'true' only for the exact string 'false'} -body {
  set fs [mock::fs::create]
  set out {}
  foreach {sv al} {false true true false yes FALSE} {
    call CCU.setInfoLedConfig [list _session_id_ AbCdEf1234 serviceLedOn $sv alarmLedOn $al] -fs $fs
    lappend out [string map [list "\n" |] [mock::fs::read $fs etc/config/hss_led_info.conf]]
  }
  mock::fs::destroy $fs
  set out
} -result {IgnoreServiceMessages=true|IgnoreAlarmMessages=false| IgnoreServiceMessages=false|IgnoreAlarmMessages=true| IgnoreServiceMessages=false|IgnoreAlarmMessages=false|}

test sp039-7 {[TARGET] setInfoLedConfig is written write-then-rename: an unwritable /etc/config is error 200, the previous file stays, no temp file} -constraints unixNotRoot -body {
  set fs [mock::fs::create]
  mock::fs::write $fs etc/config/hss_led_info.conf "IgnoreServiceMessages=false\nIgnoreAlarmMessages=false\n"
  mock::fs::write $fs etc/config/InterfacesList.xml "<interfaces/>"
  file attributes [file join $fs etc config] -permissions 0555
  set r [call CCU.setInfoLedConfig [concat $S {serviceLedOn false alarmLedOn false}] -fs $fs -interfaces 0]
  file attributes [file join $fs etc config] -permissions 0755
  set c [mock::fs::read $fs etc/config/hss_led_info.conf]
  set files [lsort [lmap f [glob -nocomplain -directory [file join $fs etc config] *] {file tail $f}]]
  mock::fs::destroy $fs
  list [lindex [err $r] 0] $c $files
} -result [list 200 "IgnoreServiceMessages=false\nIgnoreAlarmMessages=false\n" {InterfacesList.xml hss_led_info.conf}]

test sp039-8 {[TARGET] setInfoLedConfig leaves no temp file behind on success} -body {
  set fs [mock::fs::create]
  set r [call CCU.setInfoLedConfig [concat $S {serviceLedOn false alarmLedOn true}] -fs $fs]
  set files [lsort [lmap f [glob -nocomplain -directory [file join $fs etc config] *] {file tail $f}]]
  mock::fs::destroy $fs
  list [result $r] $files
} -result {true {InterfacesList.xml hss_led_info.conf}}

test sp039-9 {hideStickyUnreach: mode 'true' touches the flag, anything else removes it, result null; getStickyUnreachState is 1/0} -body {
  set a [call CCU.hideStickyUnreach [concat $S {mode true}]]
  set b [call CCU.hideStickyUnreach [concat $S {mode false}]]
  set fs [mock::fs::create]
  set s0 [result [call CCU.getStickyUnreachState $S -fs $fs]]
  mock::fs::write $fs etc/config/hideStickyUnreach ""
  set s1 [result [call CCU.getStickyUnreachState $S -fs $fs]]
  mock::fs::destroy $fs
  list [result $a] [lindex [dict get $a exec_calls] 0] [result $b] [lindex [dict get $b exec_calls] 0] $s0 $s1
} -result {null {touch /etc/config/hideStickyUnreach} null {rm /etc/config/hideStickyUnreach} 0 1}

test sp039-10 {removeFieldTestActive: true if rm printed nothing, false (e.g. file missing) otherwise} -body {
  set a [call CCU.removeFieldTestActive $S]
  set b [call CCU.removeFieldTestActive $S -execfail {{{rm*} {rm: cannot remove: No such file or directory}}}]
  list [result $a] [result $b] [lindex [dict get $a exec_calls] 0]
} -result {true false {rm /etc/config/fieldTestActive}}

test sp039-11 {ADMIN only: a USER session is denied (400) for the SP039 methods} -body {
  set codes {}
  foreach m {CCU.getSerial CCU.getAddress CCU.getHmIPAddress CCU.getVersion CCU.getHeatingGroupList CCU.getInfoLedConfig CCU.getStickyUnreachState CCU.removeFieldTestActive} {
    lappend codes [lindex [err [call $m $S -sessions $USER]] 0]
  }
  lsort -unique $codes
} -result 400

cleanupTests
