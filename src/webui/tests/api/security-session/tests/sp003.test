package require tcltest
namespace import ::tcltest::*

# SP003 - the privilege check (eq3/privilege.tcl, eq3/getupl.hms): contracts/behavioral-contracts.json#SP003
# Not covered here: the sid shape ^@?[A-Za-z0-9]{10}@?$ (acceptance[5], gated by EG-8 / T116-T117;
# privilege.tcl calls sidshape_check when that library is loaded) and the per-sid limiter that runs
# before the privilege lookup (acceptance[6], [7], tested in the dispatcher tree: T131b/T131c).
set here [file dirname [file normalize [info script]]]
set gen [file dirname [file dirname $here]]
source [file join $gen schema-harness tests helpers mocks.tcl]
# the component code lives in ::mock::generated (the tests tree is not the code tree in the repository)
set gen $::mock::generated
source [file join $gen schema-harness tests helpers golden.tcl]

set PRE {
  source [file join $env(DOCUMENT_ROOT) api/eq3/common.tcl]
  source [file join $env(DOCUMENT_ROOT) api/eq3/json.tcl]
  source [file join $env(DOCUMENT_ROOT) api/eq3/jsonrpc.tcl]
  source [file join $env(DOCUMENT_ROOT) api/eq3/hmscript.tcl]
  source [file join $env(DOCUMENT_ROOT) api/eq3/privilege.tcl]
  array set USER_LEVEL {NONE 0 GUEST 1 USER 2 ADMIN 8 0 NONE 1 GUEST 2 USER 8 ADMIN}
}
# run checkPrivilegeLevel for a method of LEVEL with the given session id
proc check {level sid args} {
  set script "$::PRE
    jsonrpc_parse {{\"method\":\"X.y\",\"params\":{},\"id\":1}}
    array set method {}
    set method(LEVEL) $level
    array set args {}
    [expr {$sid eq "__none__" ? "" : [list set args(_session_id_) $sid]}]
    if {\[catch {checkPrivilegeLevel method args} _m_\]} { jsonrpc_error 200 \"internal error: \$_m_\" }
    puts ALLOWED"
  return [golden::tcl $script -candidate only:dispatcher,security-session {*}$args]
}
proc errmsg {r} {
  if {[regexp {"code": (\d+),\s*"message": "((?:[^"\\]|\\.)*)"} [dict get $r stdout] -> c m]} { return [list $c $m] }
  if {[string match *ALLOWED* [dict get $r stdout]]} { return ALLOWED }
  return none
}
proc getupls {r} {
  set n 0
  foreach c [dict get $r rega_calls] { if {[string match *StrValueByIndex*1* $c]} { incr n } }
  return $n
}
set SESS {{AbCdEf1234 1 1000 Guest} {Usr0000000 2 1001 User} {Adm0000000 8 1002 Admin}}

test sp003-0 {the staged privilege library and getupl.hms exist} -body {
  list [file exists [file join $gen security-session eq3 privilege.tcl]] [file exists [file join $gen security-session eq3 getupl.hms]]
} -result {1 1}

test sp003-1 {a live session whose upl >= the method level proceeds; getupl.hms is executed exactly once per non-NONE request} -body {
  set out {}
  foreach {level sid} {GUEST AbCdEf1234 GUEST Usr0000000 USER Usr0000000 ADMIN Adm0000000 USER Adm0000000} {
    set r [check $level $sid -sessions $SESS]
    lappend out [errmsg $r] [getupls $r]
  }
  set out
} -result [lrepeat 5 ALLOWED 1]

test sp003-2 {LEVEL NONE: no session lookup at all (0 ReGa calls) and no _session_id_ is needed} -body {
  set r [check NONE __none__ -sessions $SESS]
  list [errmsg $r] [llength [dict get $r rega_calls]]
} -result {ALLOWED 0}

test sp003-3 {an unknown or expired session id gives upl 0: every method above NONE is denied with 400} -body {
  set out {}
  foreach level {GUEST USER ADMIN} {
    lappend out [errmsg [check $level Unknown0000 -sessions $SESS]]
  }
  set out
} -result [list {400 {access denied (\"GUEST\" needed, session level 0)}} {400 {access denied (\"USER\" needed, session level 0)}} {400 {access denied (\"ADMIN\" needed, session level 0)}}]

test sp003-4 {[TARGET] ADMIN needed with a session of upl 2: the message names the required level and the caller level (BD-07 wording), the method is not sourced} -body {
  set r [check ADMIN Usr0000000 -sessions $SESS]
  set out [dict get $r stdout]
  list [errmsg $r] [string match *ALLOWED* $out]
} -result [list {400 {access denied (\"ADMIN\" needed, session level 2)}} 0]

test sp003-5 {rega_script failing or ReGa unreachable: fail-closed 400 (no string comparison fallback)} -body {
  set r [check GUEST AbCdEf1234 -sessions $SESS -regafail {*GetSessionVarStr*}]
  lindex [errmsg $r] 0
} -result 400

test sp003-6 {[TARGET] a getupl.hms answer that is not a non-negative integer ('', 'abc', '1;2', '-1', '1.5') is denied explicitly and logged to the syslog with the correlation id} -body {
  set out {}
  foreach bad {{} abc {1;2} -1 1.5 { }} {
    set r [check GUEST AbCdEf1234 -rega [list [list {*StrValueByIndex*} $bad]]]
    set n 0
    foreach s [dict get $r syslog] { if {[regexp {cid=[0-9a-f]{16} method=X.y uid=- code=400 } $s]} { incr n } }
    lappend out [lindex [errmsg $r] 0] $n
  }
  set out
} -result [lrepeat 6 400 1]

test sp003-7 {a session id with quotes, backslash or newline is never interpolated into the script unescaped (denied, no injection)} -body {
  set out {}
  foreach sid [list "x\";Write(8);\"" "a\\b" "a\nb"] {
    set r [check GUEST $sid -sessions $SESS]
    set injected 0
    foreach c [dict get $r rega_calls] { if {[string match {*";Write(8);"*} $c]} { incr injected } }
    lappend out [lindex [errmsg $r] 0] $injected
  }
  set out
} -result {400 0 400 0 400 0}

test sp003-8 {a missing _session_id_ for a non-NONE method is a Tcl error (the dispatcher answers it before, as 402, with the corrected ARGUMENTS)} -body {
  set r [check GUEST __none__ -sessions $SESS]
  lindex [errmsg $r] 0
} -result 200

test sp003-9 {the level comparison is numeric on 0/1/2/8: GUEST passes with upl 8 and USER with upl 2, upl 0 never passes} -body {
  set out {}
  foreach {sid level} {Adm0000000 GUEST Usr0000000 USER Usr0000000 ADMIN} { lappend out [lindex [errmsg [check $level $sid -sessions $SESS]] 0] }
  set out
} -result {ALLOWED ALLOWED 400}

test sp003-10 {NFR6: with an explicit config-tool flag the check is skipped and one syslog line 'privilege check disabled (config-tool mode)' is written} -body {
  set r [golden::tcl "$::PRE
    jsonrpc_parse {{\"method\":\"X.y\",\"params\":{},\"id\":1}}
    array set method {LEVEL ADMIN}
    array set args {}
    set central false
    puts \[privilege_check_if_central method args\]
  " -candidate only:dispatcher,security-session]
  set n 0
  foreach s [dict get $r syslog] { if {[string match {*privilege check disabled (config-tool mode)*} $s]} { incr n } }
  list [llength [dict get $r rega_calls]] $n
} -result {0 1}

cleanupTests
